# Spotify API Credentials
# https://developer.spotify.com/dashboard adresinden alınabilir

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# REDIRECT URI - ÖNEMLİ!
# Spotify Developer Dashboard'da AYNI URI'yi eklemelisiniz!
# Seçenek 1 (Önerilen): localhost kullanın
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Seçenek 2: 127.0.0.1 kullanın (bazı sistemlerde daha iyi çalışır)
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# NOT: Spotify Developer Dashboard'da "Redirect URIs" bölümüne
# yukarıda seçtiğiniz URI'yi AYNEN eklemeyi unutmayın!

# Kullanıcı ayarları
IDLE_TIME_MINUTES=30
CHECK_INTERVAL_SECONDS=60

# Death grubu Spotify URI (otomatik bulunacak, manuel ayarlamaya gerek yok)
# DEATH_ARTIST_URI=spotify:artist:1Dvfqq39HxvCJ3GvfeIFuT
