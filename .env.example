# Spotify API Credentials
# https://developer.spotify.com/dashboard adresinden alınabilir

SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# REDIRECT URI - ÇOK ÖNEMLİ!
# ⚠️ Spotify artık HTTPS zorunlu tutuyor! HTTP kabul etmiyor.

# ÇÖZÜM 1 (EN KOLAY - ÖNERİLEN):
# Dummy URL kullan, manuel copy-paste yöntemi
# Dashboard'a EKLEMENIZE GEREK YOK!
# Sadece auth_manual.py scriptini çalıştırın
SPOTIFY_REDIRECT_URI=http://example.com/callback

# ÇÖZÜM 2: ngrok ile HTTPS tunnel
# ngrok kurmanız ve çalıştırmanız gerekir
# auth_ngrok.py scriptini kullanın
# SPOTIFY_REDIRECT_URI=https://xxxx.ngrok.io/callback

# ÇÖZÜM 3: Kendi HTTPS sunucunuz varsa
# SPOTIFY_REDIRECT_URI=https://yourdomain.com/callback

# NOT: Localhost HTTP artık ÇALIŞMIYOR!
# ❌ http://localhost:8888/callback - Spotify kabul etmiyor
# ❌ http://127.0.0.1:8888/callback - Spotify kabul etmiyor

# Kullanıcı ayarları
IDLE_TIME_MINUTES=30
CHECK_INTERVAL_SECONDS=60

# Death grubu Spotify URI (otomatik bulunacak, manuel ayarlamaya gerek yok)
# DEATH_ARTIST_URI=spotify:artist:1Dvfqq39HxvCJ3GvfeIFuT
